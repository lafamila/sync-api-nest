{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sync.lafamila.xyz/contracts/v2",
  "title": "Sync portable wire contract",
  "description": "ISO dates remain strings. Optional response fields tolerate unknown additions; commands reject unknown variants. Authorization, negotiation, direction and live epochs are enforced by the session runtime, not by structural decoding.",
  "x-sync": {
    "protocolVersion": 2,
    "minimumProtocolVersion": 1,
    "minimumWebProtocolVersion": 2,
    "nativePlatforms": ["macos", "ios", "android", "windows"],
    "sessionPlatforms": ["web", "macos", "ios", "android", "windows"],
    "capabilities": ["screen-host", "input-host", "host-displays", "viewer-displays", "multi-window", "mode-duration", "bounded-lifetime"],
    "limits": {
      "maxDisplays": 32, "maxDisplayIdLength": 128, "maxDisplayNameLength": 256,
      "maxDisplayDimension": 32768, "maxTextUtf8Bytes": 4096, "maxScrollDelta": 100, "maxSdpLength": 120000, "maxIceCandidateLength": 8192, "maxSignalBytes": 131072,
      "maxSequence": 9007199254740991, "maxClientVersionLength": 64, "maxCapabilities": 7,
      "minimumModeSeconds": 300, "defaultModeSeconds": 43200, "maximumModeSeconds": 604800, "defaultMaximumModeSeconds": 86400,
      "webIdleTimeoutSeconds": 900, "displaySelectionTimeoutSeconds": 10, "displayRecoveryTimeoutSeconds": 5,
      "signalingPingIntervalSeconds": 5, "signalingLivenessTimeoutSeconds": 15
    },
    "proofs": {"registration": "sync:register", "device": "sync:device"},
    "directions": {"get-displays": "controller-to-host", "select-display": "controller-to-host", "displays": "host-to-controller", "display-error": "host-to-controller"}
  },
  "$defs": {
    "UUID": {"type":"string", "format":"uuid"},
    "ISODate": {"type":"string", "format":"date-time"},
    "NativePlatform": {"type":"string", "enum":["macos","ios","android","windows"]},
    "SessionPlatform": {"type":"string", "enum":["web","macos","ios","android","windows"]},
    "Capability": {"type":"string", "enum":["screen-host","input-host","host-displays","viewer-displays","multi-window","mode-duration","bounded-lifetime"]},
    "Capabilities": {"type":"array", "items":{"$ref":"#/$defs/Capability"}, "maxItems":7, "uniqueItems":true, "default":[]},
    "ProtocolVersion": {"type":"integer", "minimum":1, "maximum":2, "default":1},
    "DisplayId": {"type":"string", "minLength":1, "maxLength":128, "pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "Key": {"type":"string", "enum":["Enter","Backspace","Tab","Escape","ArrowLeft","ArrowRight","ArrowUp","ArrowDown","Delete","Home","End","PageUp","PageDown","Space","KeyA","KeyB","KeyC","KeyD","KeyE","KeyF","KeyG","KeyH","KeyI","KeyJ","KeyK","KeyL","KeyM","KeyN","KeyO","KeyP","KeyQ","KeyR","KeyS","KeyT","KeyU","KeyV","KeyW","KeyX","KeyY","KeyZ","Digit0","Digit1","Digit2","Digit3","Digit4","Digit5","Digit6","Digit7","Digit8","Digit9"]},
    "Modifier": {"type":"string", "enum":["meta","ctrl","alt","shift"]},
    "MouseButton": {"type":"string", "enum":["left","right"]},
    "WireAccount": {"type":"object", "additionalProperties":true, "required":["id","name","permission"], "properties":{
      "id":{"type":"string","minLength":1}, "name":{"type":"string"}, "permission":{"type":"string","enum":["member","superadmin"]}
    }},
    "WireMode": {"type":"object", "additionalProperties":true, "required":["epoch","expiresAt","allowBrowser"], "properties":{
      "epoch":{"$ref":"#/$defs/UUID"}, "expiresAt":{"$ref":"#/$defs/ISODate"}, "allowBrowser":{"type":"boolean"}
    }},
    "WireDevice": {"type":"object", "additionalProperties":true, "required":["id","name","platform","online"], "properties":{
      "id":{"$ref":"#/$defs/UUID"}, "name":{"type":"string","minLength":1,"maxLength":80}, "platform":{"$ref":"#/$defs/NativePlatform"},
      "online":{"type":"boolean"}, "mode":{"$ref":"#/$defs/WireMode","x-nullable":true},
      "protocolVersion":{"$ref":"#/$defs/ProtocolVersion"}, "clientVersion":{"type":"string","x-nullable":true,"maxLength":64,"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
      "capabilities":{"$ref":"#/$defs/Capabilities"}
    }},
    "WireRemoteSession": {"type":"object", "additionalProperties":true, "required":["id","hostId","scope","epoch","expiresAt"], "properties":{
      "id":{"$ref":"#/$defs/UUID"}, "hostId":{"$ref":"#/$defs/UUID"}, "controllerId":{"type":"string","x-nullable":true},
      "scope":{"type":"string","enum":["view","control"]}, "epoch":{"$ref":"#/$defs/UUID"}, "expiresAt":{"$ref":"#/$defs/ISODate"},
      "protocolVersion":{"$ref":"#/$defs/ProtocolVersion"}, "capabilities":{"$ref":"#/$defs/Capabilities"}
    }},
    "WireICEServer": {"type":"object", "additionalProperties":true, "required":["urls"], "properties":{
      "urls":{"type":"array","items":{"type":"string","minLength":1},"minItems":1,"maxItems":16}, "username":{"type":"string"}, "credential":{"type":"string"}
    }},
    "WireSignalCandidate": {"type":"object", "additionalProperties":false, "required":["candidate"], "properties":{
      "candidate":{"type":"string","maxLength":8192}, "sdpMid":{"type":"string","maxLength":256,"x-nullable":true}, "sdpMLineIndex":{"type":"integer","minimum":0,"maximum":65535,"x-nullable":true}
    }},
    "WireDisplay": {"type":"object", "additionalProperties":false, "required":["id","name","width","height","isPrimary"], "properties":{
      "id":{"$ref":"#/$defs/DisplayId"}, "name":{"type":"string","minLength":1,"maxLength":256},
      "width":{"type":"integer","minimum":1,"maximum":32768}, "height":{"type":"integer","minimum":1,"maximum":32768}, "isPrimary":{"type":"boolean"}
    }},
    "WireSignal": {"type":"object", "additionalProperties":false, "required":["type"], "properties":{
      "type":{"type":"string","enum":["ready","session-start","offer","answer","ice","session-ended","ping","pong","get-displays","displays","select-display","display-error"]},
      "deviceId":{"$ref":"#/$defs/UUID"}, "session":{"$ref":"#/$defs/WireRemoteSession"}, "iceServers":{"type":"array","items":{"$ref":"#/$defs/WireICEServer"}},
      "sessionId":{"$ref":"#/$defs/UUID"}, "sdp":{"type":"string","minLength":1,"maxLength":120000}, "candidate":{"$ref":"#/$defs/WireSignalCandidate"}, "reason":{"type":"string","maxLength":128},
      "displays":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/WireDisplay"}}, "selectedDisplayId":{"$ref":"#/$defs/DisplayId"}, "displayId":{"$ref":"#/$defs/DisplayId"},
      "inputEpoch":{"$ref":"#/$defs/UUID"}, "requestId":{"$ref":"#/$defs/UUID"}
    }, "oneOf":[
      {"properties":{"type":{"const":"ready"}}},
      {"properties":{"type":{"const":"session-start"}},"required":["session","iceServers"]},
      {"properties":{"type":{"enum":["offer","answer"]}},"required":["sessionId","sdp"]},
      {"properties":{"type":{"const":"ice"}},"required":["sessionId","candidate"]},
      {"properties":{"type":{"const":"session-ended"}},"required":["sessionId"]},
      {"properties":{"type":{"enum":["ping","pong"]}}},
      {"properties":{"type":{"const":"get-displays"}},"required":["sessionId"]},
      {"properties":{"type":{"const":"displays"}},"required":["sessionId","displays","selectedDisplayId","inputEpoch"]},
      {"properties":{"type":{"const":"select-display"}},"required":["sessionId","displayId","inputEpoch","requestId"]},
      {"properties":{"type":{"const":"display-error"},"reason":{"enum":["unavailable","busy","permission-required","unsupported"]}},"required":["sessionId","reason"]}
    ]},
    "WireInput": {"type":"object", "additionalProperties":false, "required":["type","seq","epoch"], "properties":{
      "type":{"type":"string","enum":["heartbeat","release-all","pointer","button","scroll","key","text"]}, "seq":{"type":"integer","minimum":1,"maximum":9007199254740991},
      "epoch":{"$ref":"#/$defs/UUID"}, "inputEpoch":{"$ref":"#/$defs/UUID"}, "x":{"type":"number","minimum":0,"maximum":1}, "y":{"type":"number","minimum":0,"maximum":1},
      "button":{"$ref":"#/$defs/MouseButton"}, "down":{"type":"boolean"}, "dx":{"type":"number","minimum":-100,"maximum":100}, "dy":{"type":"number","minimum":-100,"maximum":100},
      "key":{"$ref":"#/$defs/Key"}, "modifiers":{"type":"array","items":{"$ref":"#/$defs/Modifier"},"maxItems":4,"uniqueItems":true},
      "text":{"type":"string","minLength":1,"x-maxUtf8Bytes":4096}
    }, "oneOf":[
      {"properties":{"type":{"enum":["heartbeat","release-all"]}}},
      {"properties":{"type":{"const":"pointer"}},"required":["x","y"]},
      {"properties":{"type":{"const":"button"}},"required":["x","y","button","down"]},
      {"properties":{"type":{"const":"scroll"}},"required":["dx","dy"]},
      {"properties":{"type":{"const":"key"}},"required":["key","down"]},
      {"properties":{"type":{"const":"text"}},"required":["text"]}
    ]},
    "WireChallenge": {"type":"object", "additionalProperties":true, "required":["id","nonce","expiresAt"], "properties":{
      "id":{"type":"string","minLength":24,"maxLength":128}, "nonce":{"type":"string","minLength":24,"maxLength":128}, "expiresAt":{"$ref":"#/$defs/ISODate"}
    }},
    "WireDeviceProof": {"type":"object", "additionalProperties":false, "required":["deviceId","challengeId","signature"], "properties":{
      "deviceId":{"$ref":"#/$defs/UUID"}, "challengeId":{"type":"string","minLength":24,"maxLength":128}, "signature":{"type":"string","minLength":1,"maxLength":256}
    }},
    "WireBrowserActivity": {"type":"object", "additionalProperties":false, "required":["activityToken"], "properties":{
      "activityToken":{"type":"string","minLength":24,"maxLength":256}
    }},
    "WireBrowserActivityState": {"type":"object", "additionalProperties":true, "required":["serverNow","lastActivityAt","idleDeadline"], "properties":{
      "serverNow":{"$ref":"#/$defs/ISODate"}, "lastActivityAt":{"$ref":"#/$defs/ISODate"}, "idleDeadline":{"$ref":"#/$defs/ISODate"}
    }},
    "WireBrowserAccess": {"type":"object", "additionalProperties":true, "required":["activityToken","serverNow","lastActivityAt","idleDeadline"], "properties":{
      "activityToken":{"type":"string","minLength":24,"maxLength":256}, "serverNow":{"$ref":"#/$defs/ISODate"}, "lastActivityAt":{"$ref":"#/$defs/ISODate"}, "idleDeadline":{"$ref":"#/$defs/ISODate"}
    }},
    "WireBrowserRecovery": {"type":"object", "additionalProperties":false, "required":["activityToken"], "properties":{
      "activityToken":{"type":"string","minLength":24,"maxLength":256}, "protocolVersion":{"$ref":"#/$defs/ProtocolVersion"}, "capabilities":{"$ref":"#/$defs/Capabilities"}
    }},
    "WireConnectResult": {"type":"object", "additionalProperties":true, "required":["session","ticket","iceServers"], "properties":{
      "session":{"$ref":"#/$defs/WireRemoteSession"}, "ticket":{"type":"string","minLength":1}, "iceServers":{"type":"array","items":{"$ref":"#/$defs/WireICEServer"}}, "webAccess":{"$ref":"#/$defs/WireBrowserAccess"}
    }},
    "WireModeDuration": {"type":"object", "additionalProperties":true, "required":["minimumSeconds","defaultSeconds","maximumSeconds"], "properties":{
      "minimumSeconds":{"type":"integer","minimum":300,"maximum":604800}, "defaultSeconds":{"type":"integer","minimum":300,"maximum":604800}, "maximumSeconds":{"type":"integer","minimum":300,"maximum":604800}
    }},
    "WireFeatureFlags": {"type":"object", "additionalProperties":true, "properties":{
      "displaySelection":{"type":"boolean","default":false}, "browserIdle":{"type":"boolean","default":false}, "browserRecovery":{"type":"boolean","default":false}
    }},
    "WirePublicConfig": {"type":"object", "additionalProperties":true, "properties":{
      "product":{"type":"string","default":"Sync"}, "version":{"type":"string","default":""}, "authConfigured":{"type":"boolean","default":false}, "webUrl":{"type":"string"},
      "protocolVersion":{"$ref":"#/$defs/ProtocolVersion"}, "minimumProtocolVersion":{"$ref":"#/$defs/ProtocolVersion"}, "minimumWebProtocolVersion":{"$ref":"#/$defs/ProtocolVersion"},
      "capabilities":{"$ref":"#/$defs/Capabilities"}, "modeDuration":{"$ref":"#/$defs/WireModeDuration"}, "webIdleTimeoutSeconds":{"type":"integer","minimum":1,"maximum":604800}, "requireBoundedHosts":{"type":"boolean"}, "features":{"$ref":"#/$defs/WireFeatureFlags","default":{}}
    }},
    "WireNativeHandoff": {"type":"object", "additionalProperties":false, "required":["transactionId","verifier","handoffCode"], "properties":{
      "transactionId":{"type":"string","minLength":24,"maxLength":128}, "verifier":{"type":"string","minLength":43,"maxLength":128}, "handoffCode":{"type":"string","minLength":24,"maxLength":128}
    }}
  }
}
