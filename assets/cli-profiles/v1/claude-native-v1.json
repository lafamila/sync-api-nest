{
  "schemaVersion": 1,
  "id": "claude-native-v1",
  "revision": 1,
  "provider": "claude",
  "minimumVersion": "2.1.300",
  "maximumVersion": "2.1.314",
  "operations": ["claude.discover", "claude.official-sender", "claude.selected-transcript"],
  "requiredCapabilities": ["claude.discover", "claude.official-sender", "claude.selected-transcript"],
  "selectors": {
    "discovery.rows": {"path": []},
    "discovery.id": {"path": ["sessionId"]},
    "discovery.pid": {"path": ["pid"]},
    "discovery.cwd": {"path": ["cwd"]},
    "discovery.kind": {"path": ["kind"]},
    "discovery.startedAt": {"path": ["startedAt"]},
    "discovery.name": {"path": ["name"]},
    "discovery.status": {"path": ["status"]},
    "discovery.state": {"path": ["state"]},
    "discovery.parentSessionId": {"path": ["parentSessionId"]},
    "discovery.parentAgentId": {"path": ["parentAgentId"]},
    "discovery.ephemeral": {"path": ["isEphemeral"]},
    "discovery.subagent": {"path": ["isSubagent"]},
    "discovery.internal": {"path": ["isInternal"]},
    "history.id": {"path": ["uuid"]},
    "history.role": {"path": ["message", "role"]},
    "history.type": {"path": ["type"]},
    "history.text": {"path": ["message", "content"]},
    "history.blocks": {"path": ["message", "content"]},
    "history.blockType": {"path": ["type"]},
    "history.blockText": {"path": ["text"]},
    "history.timestamp": {"path": ["timestamp"]},
    "ack.accepted": {"path": ["delivered"]}
  },
  "roleMap": {"user": "user", "assistant": "assistant"},
  "statusMap": {"idle": "idle", "busy": "busy", "working": "busy", "waiting": "waiting", "blocked": "waiting", "unknown": "unknown"}
}
