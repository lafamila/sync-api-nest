NODE_ENV=development
HOST=0.0.0.0
PORT=3053
SYNC_PUBLIC_URL=http://localhost:3053
SYNC_ALLOWED_ORIGINS=http://127.0.0.1:3053,http://localhost:5179,http://127.0.0.1:5179

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sync_dev
DATABASE_SSL=false
SYNC_AUTO_MIGRATE=true
REDIS_URL=redis://127.0.0.1:6379
SYNC_REDIS_KEY_PREFIX=sync:dev
SYNC_INSTANCE_LEASE_TTL_SECONDS=15

SYNC_AUTH_ISSUER_URL=http://localhost:3032
SYNC_AUTH_JWKS_URL=http://localhost:3032/oauth/jwks
SYNC_AUTH_AUDIENCE=service:sync
# Optional browser-reachable authorization endpoint; issuer/token/JWKS stay server-side.
SYNC_OIDC_AUTHORIZATION_URL=
SYNC_OIDC_CLIENT_ID=sync-api
SYNC_OIDC_CLIENT_SECRET=
SYNC_OIDC_REDIRECT_URI=http://localhost:3053/api/session/oidc/callback
SYNC_SESSION_ENCRYPTION_KEY=
SYNC_PIN_PEPPER=

SYNC_SESSION_TTL_SECONDS=2592000
SYNC_AUTH_RECHECK_SECONDS=20
SYNC_AUTH_HTTP_TIMEOUT_MS=5000
SYNC_LOGIN_TRANSACTION_TTL_SECONDS=300
SYNC_NATIVE_HANDOFF_TTL_SECONDS=60
SYNC_LOGIN_RATE_PER_IP=20
SYNC_LOGIN_RATE_GLOBAL=120
SYNC_DEVICE_CHALLENGE_TTL_SECONDS=120
SYNC_MODE_DEFAULT_TTL_SECONDS=43200
SYNC_MODE_MAX_TTL_SECONDS=86400
SYNC_PIN_FAILURE_LIMIT=5
SYNC_TICKET_TTL_SECONDS=60
SYNC_REMOTE_SESSION_TTL_SECONDS=3600
SYNC_WEB_IDLE_TIMEOUT_SECONDS=900
# Defaults true in production, false in development/test. Explicit false permits legacy compatibility, not bounded safety.
# SYNC_REQUIRE_BOUNDED_HOSTS=true
# bounded-lifetime is a raw active-host feature declaration, not tamper attestation or an authorization grant.

SYNC_STUN_URLS=stun:stun.l.google.com:19302
SYNC_TURN_URLS=
SYNC_TURN_SECRET=
SYNC_TURN_TTL_SECONDS=600
SYNC_TURN_USERNAME_PREFIX=sync

# Read by the main-owned deploy/coturn tooling. The API intentionally ignores these.
SYNC_TURN_IMAGE=
SYNC_TURN_EXTERNAL_IP=
SYNC_TURN_REALM=sync
SYNC_TURN_PORT=3478
SYNC_TURN_MIN_PORT=49160
SYNC_TURN_MAX_PORT=49200
SYNC_TURN_BIND_ADDRESS=127.0.0.1
SYNC_TURN_ALLOW_LOOPBACK=false
SYNC_TURN_ENABLE_TLS=false
SYNC_TURN_TLS_PORT=5349
SYNC_TURN_TLS_BIND_PORT=5349
SYNC_TURN_CERT_PATH=
SYNC_TURN_KEY_PATH=
